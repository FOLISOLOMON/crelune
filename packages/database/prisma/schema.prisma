datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS (Milestone 3 Stage 3.1 Member & Birthday Domain)
// -----------------------------------------------------------------------------

enum LeapDayPolicy {
  FEB_28
  MAR_1
}

enum BirthdayPrepStatus {
  UPCOMING
  PREPARATION_PENDING
  DESIGN_IN_PROGRESS
  AWAITING_APPROVAL
  PUBLISHED
  SKIPPED
}

enum ReminderStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

enum NotificationType {
  BIRTHDAY_REMINDER
  SYSTEM
}

enum StorageCleanupStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum StorageCleanupReason {
  POST_UPLOAD_VERIFY_FAILURE
  DB_TRANSACTION_ROLLBACK
  PREVIOUS_PHOTO_CLEANUP
  MEMBER_PHOTO_REMOVED
}

// -----------------------------------------------------------------------------
// ENUMS (Milestone 4 Design Management Domain)
// -----------------------------------------------------------------------------

enum DesignCategory {
  BIRTHDAY_FLYER
  CHURCH_PROGRAMME_FLYER
  EVENT_ANNOUNCEMENT
  SERVICE_FLYER
  SOCIAL_MEDIA_GRAPHIC
  SPECIAL_EVENT_ARTWORK
  GENERAL_GRAPHIC_DESIGN
}

enum DesignJobStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  AWAITING_REVIEW
  APPROVED
  EXPORTED
  PUBLISHED
  CANCELLED
}

enum DesignPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// -----------------------------------------------------------------------------
// CORE ORGANISATION & USER MANAGEMENT (Milestone 2 Web Foundation)
// -----------------------------------------------------------------------------

model Organisation {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  logoUrl              String?               @map("logo_url")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  users                User[]
  members              Member[]
  birthdayPreparations BirthdayPreparation[]
  birthdayReminders    BirthdayReminder[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  pendingCleanups      PendingStorageCleanup[]
  designJobs              DesignJob[]
  templates               Template[]
  templateVersions        TemplateVersion[]
  templateFieldMappings   TemplateFieldMapping[]
  creativeUploadIntents   CreativeUploadIntent[]
  creativeAgents          CreativeAgent[]
  creativeJobDispatches   CreativeJobDispatch[]
  exportRecords           ExportRecord[]
  creativeStorageCleanups CreativeStorageCleanup[]

  @@map("organisations")
}

model User {
  id                  String          @id @default(cuid())
  organisationId      String          @map("organisation_id")
  email               String          @unique
  passwordHash        String          @map("password_hash")
  firstName           String          @map("first_name")
  lastName            String          @map("last_name")
  role                String          @default("OWNER")
  isActive            Boolean         @default(true) @map("is_active")
  sessionVersion      Int             @default(1) @map("session_version")
  // Retained non-destructively from Milestone 2.1; superseded by AuthThrottle in Milestone 2.1.1
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  organisation        Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  preferences         UserPreference?
  notifications       Notification[]
  auditLogs           AuditLog[]
  designJobChanges          DesignJobHistory[]
  templatesCreated          Template[]              @relation("TemplateCreator")
  templateVersionsUploaded  TemplateVersion[]       @relation("TemplateVersionUploader")
  creativeUploadIntents     CreativeUploadIntent[]  @relation("CreativeUploadRequester")
  creativeAgentsRegistered  CreativeAgent[]         @relation("CreativeAgentRegistrar")
  creativeAgentsRevoked     CreativeAgent[]         @relation("CreativeAgentRevoker")
  creativeDispatchesOrdered CreativeJobDispatch[]   @relation("CreativeDispatchRequester")
  exportsUploaded           ExportRecord[]          @relation("ExportUploader")
  exportsOwnerApproved      ExportRecord[]          @relation("ExportOwnerApprover")

  @@index([organisationId])
  @@map("users")
}

model UserPreference {
  id                   String        @id @default(cuid())
  userId               String        @unique @map("user_id")
  theme                String        @default("light")
  dateFormat           String        @default("DD/MM/YYYY") @map("date_format")
  timezone             String        @default("Africa/Accra")
  leadTimeDaysBirthday Int           @default(14) @map("lead_time_days_birthday")
  birthdayReminderDays Int[]         @default([7, 3, 1, 0]) @map("birthday_reminder_days")
  leapDayPolicy        LeapDayPolicy @default(FEB_28) @map("leap_day_policy")
  leadTimeDaysEvent    Int           @default(21) @map("lead_time_days_event")
  defaultExportFormat  String        @default("PNG") @map("default_export_format")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// -----------------------------------------------------------------------------
// DURABLE AUTHENTICATION RATE LIMITING & THROTTLING (Milestone 2.1.1)
// -----------------------------------------------------------------------------

model AuthThrottle {
  bucketKey    String    @id @map("bucket_key")
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@index([windowStart])
  @@map("auth_throttles")
}

// -----------------------------------------------------------------------------
// MEMBER & BIRTHDAY DATA FOUNDATION (Milestone 3 Stage 3.1)
// -----------------------------------------------------------------------------

model Member {
  id                   String                @id @default(cuid())
  organisationId       String                @map("organisation_id")
  fullName             String                @map("full_name")
  preferredName        String?               @map("preferred_name")
  normalizedName       String                @map("normalized_name")
  birthDay             Int?                  @map("birth_day")
  birthMonth           Int?                  @map("birth_month")
  birthYear            Int?                  @map("birth_year")
  phone                String?
  normalizedPhone      String?               @map("normalized_phone")
  email                String?
  notes                String?
  // Architecture-approved Neon Object Storage object metadata (buckets provisioned in Stage 3.3)
  photoStorageKey      String?               @map("photo_storage_key")
  photoMimeType        String?               @map("photo_mime_type")
  photoByteSize        Int?                  @map("photo_byte_size")
  photoUpdatedAt       DateTime?             @map("photo_updated_at")
  // Single source of truth for archival; active records satisfy archivedAt IS NULL
  archivedAt           DateTime?             @map("archived_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  birthdayPreparations BirthdayPreparation[]
  birthdayReminders    BirthdayReminder[]
  notifications        Notification[]
  designJobs           DesignJob[]

  @@index([organisationId, archivedAt, birthMonth, birthDay])
  @@index([organisationId, normalizedName])
  @@index([organisationId, normalizedPhone])
  @@index([organisationId, archivedAt])
  @@map("members")
}

model BirthdayPreparation {
  id              String             @id @default(cuid())
  organisationId  String             @map("organisation_id")
  memberId        String             @map("member_id")
  targetYear      Int                @map("target_year")
  celebrationDate DateTime           @map("celebration_date") @db.Date
  status          BirthdayPrepStatus @default(UPCOMING)
  designJobId     String?            @map("design_job_id")
  notes           String?
  statusUpdatedAt DateTime           @default(now()) @map("status_updated_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  designJob       DesignJob?         @relation(fields: [designJobId], references: [id], onDelete: SetNull)

  @@unique([memberId, targetYear])
  @@index([organisationId, targetYear, status])
  @@index([organisationId, celebrationDate])
  @@index([designJobId])
  @@map("birthday_preparations")
}

model BirthdayReminder {
  id               String         @id @default(cuid())
  organisationId   String         @map("organisation_id")
  memberId         String         @map("member_id")
  targetYear       Int            @map("target_year")
  leadDays         Int            @map("lead_days")
  scheduledForDate DateTime       @map("scheduled_for_date") @db.Date
  status           ReminderStatus @default(PENDING)
  idempotencyKey   String         @unique @map("idempotency_key")
  attemptCount     Int            @default(0) @map("attempt_count")
  lastError        String?        @map("last_error")
  sentAt           DateTime?      @map("sent_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notification     Notification?

  @@unique([memberId, targetYear, leadDays])
  @@index([organisationId, scheduledForDate, status])
  @@map("birthday_reminders")
}

model Notification {
  id                 String            @id @default(cuid())
  organisationId     String            @map("organisation_id")
  userId             String            @map("user_id")
  memberId           String?           @map("member_id")
  birthdayReminderId String?           @unique @map("birthday_reminder_id")
  type               NotificationType  @default(BIRTHDAY_REMINDER)
  title              String
  body               String
  href               String?
  readAt             DateTime?         @map("read_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  member             Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  birthdayReminder   BirthdayReminder? @relation(fields: [birthdayReminderId], references: [id], onDelete: SetNull)

  @@index([organisationId, userId, readAt, createdAt])
  @@index([memberId])
  @@map("notifications")
}

// Append-only at the application-service level (no updatedAt or mutable update workflow).
model AuditLog {
  id             String       @id @default(cuid())
  organisationId String       @map("organisation_id")
  actorUserId    String?      @map("actor_user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, entityType, entityId])
  @@map("audit_logs")
}

// Durable retry queue for failed private object storage deletions (Stage 3.3.1).
// Every queued key is scope-validated against environment, organisation, and member
// bounds before enqueue and again before any storage deletion attempt.
model PendingStorageCleanup {
  id             String               @id @default(cuid())
  organisationId String               @map("organisation_id")
  memberId       String               @map("member_id")
  storageKey     String               @unique @map("storage_key")
  reason         StorageCleanupReason
  status         StorageCleanupStatus @default(PENDING)
  attemptCount   Int                  @default(0) @map("attempt_count")
  lastError      String?              @map("last_error")
  nextRetryAt    DateTime             @default(now()) @map("next_retry_at")
  completedAt    DateTime?            @map("completed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, status, nextRetryAt])
  @@index([memberId])
  @@map("pending_storage_cleanups")
}

// -----------------------------------------------------------------------------
// DESIGN MANAGEMENT PIPELINE (Milestone 4)
// -----------------------------------------------------------------------------

model DesignJob {
  id                    String                @id @default(cuid())
  organisationId        String                @map("organisation_id")
  memberId              String?               @map("member_id")
  birthdayTargetYear    Int?                  @map("birthday_target_year")
  title                 String
  category              DesignCategory        @default(GENERAL_GRAPHIC_DESIGN)
  status                DesignJobStatus       @default(DRAFT)
  priority              DesignPriority        @default(NORMAL)
  requiredText          String?               @map("required_text")
  dimensions            String?
  targetPlatform        String?               @map("target_platform")
  preferredTemplateNote String?               @map("preferred_template_note")
  templateId            String?               @map("template_id")
  templateVersionId     String?               @map("template_version_id")
  referenceNotes        String?               @map("reference_notes")
  notes                 String?
  dueDate               DateTime?             @map("due_date") @db.Date
  approvedAt            DateTime?             @map("approved_at")
  exportedAt            DateTime?             @map("exported_at")
  publishedAt           DateTime?             @map("published_at")
  cancelledAt           DateTime?             @map("cancelled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  organisation          Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member                Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)
  template              Template?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion       TemplateVersion?      @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  birthdayPreparations  BirthdayPreparation[]
  history               DesignJobHistory[]
  creativeDispatches    CreativeJobDispatch[]
  exportRecords         ExportRecord[]

  @@index([organisationId, status])
  @@index([organisationId, memberId])
  @@index([organisationId, templateId])
  @@index([organisationId, templateVersionId])
  @@index([organisationId, dueDate])
  @@map("design_jobs")
}

model DesignJobHistory {
  id              String           @id @default(cuid())
  organisationId  String           @map("organisation_id")
  designJobId     String           @map("design_job_id")
  previousStatus  DesignJobStatus? @map("previous_status")
  newStatus       DesignJobStatus  @map("new_status")
  note            String?
  changedByUserId String?          @map("changed_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  designJob       DesignJob        @relation(fields: [designJobId], references: [id], onDelete: Cascade)
  changedByUser   User?            @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, designJobId, createdAt])
  @@map("design_job_history")
}

// -----------------------------------------------------------------------------
// TEMPLATES, CREATIVE STORAGE & WINDOWS CREATIVE AGENT (Milestone 5.1)
// -----------------------------------------------------------------------------

enum TemplateStudioType {
  AFFINITY_PHOTO
  AFFINITY_DESIGNER
  AFFINITY_PUBLISHER
  AFFINITY_STUDIO
}

enum TemplateFileFormat {
  PSD
  AF
  AFPHOTO
  AFDESIGN
  AFPUB
}

enum TemplateInspectionStatus {
  PENDING
  INSPECTED
  MANUAL_REQUIRED
  FAILED
}

enum TemplateFieldType {
  TEXT
  IMAGE
  DATE
  COLOR
}

enum CreativeUploadKind {
  TEMPLATE_MASTER
  TEMPLATE_PREVIEW
  WORKING_ASSET
  EXPORT_DELIVERABLE
}

enum CreativeUploadStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  ABANDONED
}

enum CreativeAgentStatus {
  ACTIVE
  REVOKED
}

enum CreativeDispatchStatus {
  QUEUED
  CLAIMED
  DOWNLOADING_ASSETS
  OPENING_TEMPLATE
  READY_FOR_ARTIST
  EXPORTING
  EXPORTED
  FAILED
  CANCELLED
}

enum ExportFileFormat {
  PNG
  JPEG
  PDF
}

enum CreativeStorageCleanupReason {
  UPLOAD_ABANDONED
  UPLOAD_REJECTED
  TEMPLATE_VERSION_RETIRED
  DISPATCH_CLEANUP
  EXPORT_SUPERSEDED
}

model Template {
  id              String             @id @default(cuid())
  organisationId  String             @map("organisation_id")
  name            String
  normalizedName  String             @map("normalized_name")
  category        DesignCategory     @default(GENERAL_GRAPHIC_DESIGN)
  studioType      TemplateStudioType @map("studio_type")
  description     String?
  activeVersionId String?            @unique @map("active_version_id")
  createdByUserId String             @map("created_by_user_id")
  isActive        Boolean            @default(true) @map("is_active")
  archivedAt      DateTime?          @map("archived_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdByUser   User               @relation("TemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        TemplateVersion[]  @relation("TemplateVersions")
  activeVersion   TemplateVersion?   @relation("ActiveTemplateVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  designJobs      DesignJob[]

  @@index([organisationId, category, isActive])
  @@index([organisationId, archivedAt])
  @@index([organisationId, normalizedName])
  @@map("templates")
}

model TemplateVersion {
  id                 String                   @id @default(cuid())
  organisationId     String                   @map("organisation_id")
  templateId         String                   @map("template_id")
  versionNumber      Int                      @map("version_number")
  format             TemplateFileFormat
  storageBucket      String                   @map("storage_bucket")
  storageKey         String                   @unique @map("storage_key")
  previewStorageKey  String?                  @unique @map("preview_storage_key")
  previewMimeType    String?                  @map("preview_mime_type")
  previewByteSize    Int?                     @map("preview_byte_size")
  originalFilename   String                   @map("original_filename")
  mimeType           String                   @map("mime_type")
  byteSize           Int                      @map("byte_size")
  sha256             String
  widthPx            Int?                     @map("width_px")
  heightPx           Int?                     @map("height_px")
  inspectionStatus   TemplateInspectionStatus @default(PENDING) @map("inspection_status")
  inspectionSummary  String?                  @map("inspection_summary")
  detectedLayersJson Json?                    @map("detected_layers_json")
  inspectedAt        DateTime?                @map("inspected_at")
  uploadedByUserId   String                   @map("uploaded_by_user_id")
  uploadIntentId     String?                  @unique @map("upload_intent_id")
  createdAt          DateTime                 @default(now()) @map("created_at")

  organisation       Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  template           Template                 @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Restrict)
  activeForTemplate  Template?                @relation("ActiveTemplateVersion")
  uploadedByUser     User                     @relation("TemplateVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadIntent       CreativeUploadIntent?    @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)
  fieldMappings      TemplateFieldMapping[]
  designJobs         DesignJob[]
  dispatches         CreativeJobDispatch[]

  @@unique([templateId, versionNumber])
  @@index([organisationId, templateId, createdAt])
  @@map("template_versions")
}

model TemplateFieldMapping {
  id                String            @id @default(cuid())
  organisationId    String            @map("organisation_id")
  templateVersionId String            @map("template_version_id")
  fieldKey          String            @map("field_key")
  fieldType         TemplateFieldType @map("field_type")
  targetLayerName   String            @map("target_layer_name")
  layerPathJson     Json?             @map("layer_path_json")
  isRequired        Boolean           @default(false) @map("is_required")
  defaultValue      String?           @map("default_value")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  templateVersion   TemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, fieldKey])
  @@index([organisationId, templateVersionId])
  @@map("template_field_mappings")
}

model CreativeUploadIntent {
  id                String               @id @default(cuid())
  organisationId    String               @map("organisation_id")
  requestedByUserId String?              @map("requested_by_user_id")
  agentId           String?              @map("agent_id")
  kind              CreativeUploadKind
  idempotencyKey    String               @unique @map("idempotency_key")
  storageBucket     String               @map("storage_bucket")
  storageKey        String               @unique @map("storage_key")
  expectedMimeType  String               @map("expected_mime_type")
  expectedByteSize  Int                  @map("expected_byte_size")
  expectedSha256    String?              @map("expected_sha256")
  maxAllowedBytes   Int                  @map("max_allowed_bytes")
  status            CreativeUploadStatus @default(PENDING)
  verifiedByteSize  Int?                 @map("verified_byte_size")
  verifiedSha256    String?              @map("verified_sha256")
  rejectionReason   String?              @map("rejection_reason")
  expiresAt         DateTime             @map("expires_at")
  verifiedAt        DateTime?            @map("verified_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organisation      Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  requestedByUser   User?                @relation("CreativeUploadRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  agent             CreativeAgent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  templateVersion   TemplateVersion?
  exportRecord      ExportRecord?

  @@index([organisationId, status, expiresAt])
  @@index([agentId, status])
  @@map("creative_upload_intents")
}

model CreativeAgent {
  id                 String                @id @default(cuid())
  organisationId     String                @map("organisation_id")
  registeredByUserId String                @map("registered_by_user_id")
  name               String
  machineLabel       String                @map("machine_label")
  tokenHash          String                @unique @map("token_hash")
  tokenPrefix        String                @map("token_prefix")
  status             CreativeAgentStatus   @default(ACTIVE)
  agentVersion       String?               @map("agent_version")
  affinityVersion    String?               @map("affinity_version")
  capabilitiesJson   Json?                 @map("capabilities_json")
  lastHeartbeatAt    DateTime?             @map("last_heartbeat_at")
  revokedAt          DateTime?             @map("revoked_at")
  revokedByUserId    String?               @map("revoked_by_user_id")
  revocationReason   String?               @map("revocation_reason")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  organisation       Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  registeredByUser   User                  @relation("CreativeAgentRegistrar", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  revokedByUser      User?                 @relation("CreativeAgentRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  dispatches         CreativeJobDispatch[]
  uploadIntents      CreativeUploadIntent[]
  exportRecords      ExportRecord[]

  @@index([organisationId, status])
  @@map("creative_agents")
}

model CreativeJobDispatch {
  id                String                 @id @default(cuid())
  organisationId    String                 @map("organisation_id")
  designJobId       String                 @map("design_job_id")
  templateVersionId String                 @map("template_version_id")
  assignedAgentId   String?                @map("assigned_agent_id")
  requestedByUserId String                 @map("requested_by_user_id")
  idempotencyKey    String                 @unique @map("idempotency_key")
  manifestVersion   Int                    @default(1) @map("manifest_version")
  manifestJson      Json                   @map("manifest_json")
  status            CreativeDispatchStatus @default(QUEUED)
  claimTokenHash    String?                @map("claim_token_hash")
  leaseExpiresAt    DateTime?              @map("lease_expires_at")
  claimedAt         DateTime?              @map("claimed_at")
  readyForArtistAt  DateTime?              @map("ready_for_artist_at")
  completedAt       DateTime?              @map("completed_at")
  failedAt          DateTime?              @map("failed_at")
  errorCode         String?                @map("error_code")
  errorMessage      String?                @map("error_message")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  organisation      Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  designJob         DesignJob              @relation(fields: [designJobId], references: [id], onDelete: Cascade)
  templateVersion   TemplateVersion        @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  assignedAgent     CreativeAgent?         @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  requestedByUser   User                   @relation("CreativeDispatchRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  exportRecords     ExportRecord[]

  @@index([organisationId, status, createdAt])
  @@index([designJobId, createdAt])
  @@index([assignedAgentId, status])
  @@map("creative_job_dispatches")
}

model ExportRecord {
  id                    String               @id @default(cuid())
  organisationId        String               @map("organisation_id")
  designJobId           String               @map("design_job_id")
  dispatchId            String?              @map("dispatch_id")
  uploadedByAgentId     String?              @map("uploaded_by_agent_id")
  uploadedByUserId      String?              @map("uploaded_by_user_id")
  uploadIntentId        String?              @unique @map("upload_intent_id")
  format                ExportFileFormat
  storageBucket         String               @map("storage_bucket")
  storageKey            String               @unique @map("storage_key")
  mimeType              String               @map("mime_type")
  byteSize              Int                  @map("byte_size")
  sha256                String
  widthPx               Int?                 @map("width_px")
  heightPx              Int?                 @map("height_px")
  resolutionDpi         Int?                 @map("resolution_dpi")
  isApprovedForPublish  Boolean              @default(false) @map("is_approved_for_publish")
  ownerApprovedAt       DateTime?            @map("owner_approved_at")
  ownerApprovedByUserId String?              @map("owner_approved_by_user_id")
  publishedAt           DateTime?            @map("published_at")
  createdAt             DateTime             @default(now()) @map("created_at")

  organisation          Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  designJob             DesignJob            @relation(fields: [designJobId], references: [id], onDelete: Cascade)
  dispatch              CreativeJobDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  uploadedByAgent       CreativeAgent?       @relation(fields: [uploadedByAgentId], references: [id], onDelete: SetNull)
  uploadedByUser        User?                @relation("ExportUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  ownerApprovedByUser   User?                @relation("ExportOwnerApprover", fields: [ownerApprovedByUserId], references: [id], onDelete: SetNull)
  uploadIntent          CreativeUploadIntent? @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)

  @@index([organisationId, designJobId, createdAt])
  @@index([dispatchId])
  @@map("export_records")
}

model CreativeStorageCleanup {
  id             String                       @id @default(cuid())
  organisationId String                       @map("organisation_id")
  bucket         String
  objectKey      String                       @unique @map("object_key")
  reason         CreativeStorageCleanupReason
  status         StorageCleanupStatus         @default(PENDING)
  attempts       Int                          @default(0)
  lastError      String?                      @map("last_error")
  nextRetryAt    DateTime                     @default(now()) @map("next_retry_at")
  resolvedAt     DateTime?                    @map("resolved_at")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  organisation   Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([status, nextRetryAt])
  @@index([organisationId, createdAt])
  @@map("creative_storage_cleanups")
}