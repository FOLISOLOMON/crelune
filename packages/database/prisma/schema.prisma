datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS (Milestone 3 Stage 3.1 Member & Birthday Domain)
// -----------------------------------------------------------------------------

enum LeapDayPolicy {
  FEB_28
  MAR_1
}

enum BirthdayPrepStatus {
  UPCOMING
  PREPARATION_PENDING
  DESIGN_IN_PROGRESS
  AWAITING_APPROVAL
  PUBLISHED
  SKIPPED
}

enum ReminderStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

enum NotificationType {
  BIRTHDAY_REMINDER
  SYSTEM
}

enum StorageCleanupStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum StorageCleanupReason {
  POST_UPLOAD_VERIFY_FAILURE
  DB_TRANSACTION_ROLLBACK
  PREVIOUS_PHOTO_CLEANUP
  MEMBER_PHOTO_REMOVED
}

// -----------------------------------------------------------------------------
// ENUMS (Milestone 4 Design Management Domain)
// -----------------------------------------------------------------------------

enum DesignCategory {
  BIRTHDAY_FLYER
  CHURCH_PROGRAMME_FLYER
  EVENT_ANNOUNCEMENT
  SERVICE_FLYER
  SOCIAL_MEDIA_GRAPHIC
  SPECIAL_EVENT_ARTWORK
  GENERAL_GRAPHIC_DESIGN
}

enum DesignJobStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  AWAITING_REVIEW
  APPROVED
  EXPORTED
  PUBLISHED
  CANCELLED
}

enum DesignPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// -----------------------------------------------------------------------------
// CORE ORGANISATION & USER MANAGEMENT (Milestone 2 Web Foundation)
// -----------------------------------------------------------------------------

model Organisation {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  logoUrl              String?               @map("logo_url")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  users                User[]
  members              Member[]
  birthdayPreparations BirthdayPreparation[]
  birthdayReminders    BirthdayReminder[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  pendingCleanups      PendingStorageCleanup[]
  designJobs           DesignJob[]

  @@map("organisations")
}

model User {
  id                  String          @id @default(cuid())
  organisationId      String          @map("organisation_id")
  email               String          @unique
  passwordHash        String          @map("password_hash")
  firstName           String          @map("first_name")
  lastName            String          @map("last_name")
  role                String          @default("OWNER")
  isActive            Boolean         @default(true) @map("is_active")
  sessionVersion      Int             @default(1) @map("session_version")
  // Retained non-destructively from Milestone 2.1; superseded by AuthThrottle in Milestone 2.1.1
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  organisation        Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  preferences         UserPreference?
  notifications       Notification[]
  auditLogs           AuditLog[]
  designJobChanges    DesignJobHistory[]

  @@index([organisationId])
  @@map("users")
}

model UserPreference {
  id                   String        @id @default(cuid())
  userId               String        @unique @map("user_id")
  theme                String        @default("light")
  dateFormat           String        @default("DD/MM/YYYY") @map("date_format")
  timezone             String        @default("Africa/Accra")
  leadTimeDaysBirthday Int           @default(14) @map("lead_time_days_birthday")
  birthdayReminderDays Int[]         @default([7, 3, 1, 0]) @map("birthday_reminder_days")
  leapDayPolicy        LeapDayPolicy @default(FEB_28) @map("leap_day_policy")
  leadTimeDaysEvent    Int           @default(21) @map("lead_time_days_event")
  defaultExportFormat  String        @default("PNG") @map("default_export_format")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// -----------------------------------------------------------------------------
// DURABLE AUTHENTICATION RATE LIMITING & THROTTLING (Milestone 2.1.1)
// -----------------------------------------------------------------------------

model AuthThrottle {
  bucketKey    String    @id @map("bucket_key")
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@index([windowStart])
  @@map("auth_throttles")
}

// -----------------------------------------------------------------------------
// MEMBER & BIRTHDAY DATA FOUNDATION (Milestone 3 Stage 3.1)
// -----------------------------------------------------------------------------

model Member {
  id                   String                @id @default(cuid())
  organisationId       String                @map("organisation_id")
  fullName             String                @map("full_name")
  preferredName        String?               @map("preferred_name")
  normalizedName       String                @map("normalized_name")
  birthDay             Int?                  @map("birth_day")
  birthMonth           Int?                  @map("birth_month")
  birthYear            Int?                  @map("birth_year")
  phone                String?
  normalizedPhone      String?               @map("normalized_phone")
  email                String?
  notes                String?
  // Architecture-approved Neon Object Storage object metadata (buckets provisioned in Stage 3.3)
  photoStorageKey      String?               @map("photo_storage_key")
  photoMimeType        String?               @map("photo_mime_type")
  photoByteSize        Int?                  @map("photo_byte_size")
  photoUpdatedAt       DateTime?             @map("photo_updated_at")
  // Single source of truth for archival; active records satisfy archivedAt IS NULL
  archivedAt           DateTime?             @map("archived_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  birthdayPreparations BirthdayPreparation[]
  birthdayReminders    BirthdayReminder[]
  notifications        Notification[]
  designJobs           DesignJob[]

  @@index([organisationId, archivedAt, birthMonth, birthDay])
  @@index([organisationId, normalizedName])
  @@index([organisationId, normalizedPhone])
  @@index([organisationId, archivedAt])
  @@map("members")
}

model BirthdayPreparation {
  id              String             @id @default(cuid())
  organisationId  String             @map("organisation_id")
  memberId        String             @map("member_id")
  targetYear      Int                @map("target_year")
  celebrationDate DateTime           @map("celebration_date") @db.Date
  status          BirthdayPrepStatus @default(UPCOMING)
  designJobId     String?            @map("design_job_id")
  notes           String?
  statusUpdatedAt DateTime           @default(now()) @map("status_updated_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  designJob       DesignJob?         @relation(fields: [designJobId], references: [id], onDelete: SetNull)

  @@unique([memberId, targetYear])
  @@index([organisationId, targetYear, status])
  @@index([organisationId, celebrationDate])
  @@index([designJobId])
  @@map("birthday_preparations")
}

model BirthdayReminder {
  id               String         @id @default(cuid())
  organisationId   String         @map("organisation_id")
  memberId         String         @map("member_id")
  targetYear       Int            @map("target_year")
  leadDays         Int            @map("lead_days")
  scheduledForDate DateTime       @map("scheduled_for_date") @db.Date
  status           ReminderStatus @default(PENDING)
  idempotencyKey   String         @unique @map("idempotency_key")
  attemptCount     Int            @default(0) @map("attempt_count")
  lastError        String?        @map("last_error")
  sentAt           DateTime?      @map("sent_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notification     Notification?

  @@unique([memberId, targetYear, leadDays])
  @@index([organisationId, scheduledForDate, status])
  @@map("birthday_reminders")
}

model Notification {
  id                 String            @id @default(cuid())
  organisationId     String            @map("organisation_id")
  userId             String            @map("user_id")
  memberId           String?           @map("member_id")
  birthdayReminderId String?           @unique @map("birthday_reminder_id")
  type               NotificationType  @default(BIRTHDAY_REMINDER)
  title              String
  body               String
  href               String?
  readAt             DateTime?         @map("read_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  member             Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  birthdayReminder   BirthdayReminder? @relation(fields: [birthdayReminderId], references: [id], onDelete: SetNull)

  @@index([organisationId, userId, readAt, createdAt])
  @@index([memberId])
  @@map("notifications")
}

// Append-only at the application-service level (no updatedAt or mutable update workflow).
model AuditLog {
  id             String       @id @default(cuid())
  organisationId String       @map("organisation_id")
  actorUserId    String?      @map("actor_user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, entityType, entityId])
  @@map("audit_logs")
}

// Durable retry queue for failed private object storage deletions (Stage 3.3.1).
// Every queued key is scope-validated against environment, organisation, and member
// bounds before enqueue and again before any storage deletion attempt.
model PendingStorageCleanup {
  id             String               @id @default(cuid())
  organisationId String               @map("organisation_id")
  memberId       String               @map("member_id")
  storageKey     String               @unique @map("storage_key")
  reason         StorageCleanupReason
  status         StorageCleanupStatus @default(PENDING)
  attemptCount   Int                  @default(0) @map("attempt_count")
  lastError      String?              @map("last_error")
  nextRetryAt    DateTime             @default(now()) @map("next_retry_at")
  completedAt    DateTime?            @map("completed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, status, nextRetryAt])
  @@index([memberId])
  @@map("pending_storage_cleanups")
}

// -----------------------------------------------------------------------------
// DESIGN MANAGEMENT PIPELINE (Milestone 4)
// -----------------------------------------------------------------------------

model DesignJob {
  id                    String                @id @default(cuid())
  organisationId        String                @map("organisation_id")
  memberId              String?               @map("member_id")
  birthdayTargetYear    Int?                  @map("birthday_target_year")
  title                 String
  category              DesignCategory        @default(GENERAL_GRAPHIC_DESIGN)
  status                DesignJobStatus       @default(DRAFT)
  priority              DesignPriority        @default(NORMAL)
  requiredText          String?               @map("required_text")
  dimensions            String?
  targetPlatform        String?               @map("target_platform")
  preferredTemplateNote String?               @map("preferred_template_note")
  referenceNotes        String?               @map("reference_notes")
  notes                 String?
  dueDate               DateTime?             @map("due_date") @db.Date
  approvedAt            DateTime?             @map("approved_at")
  exportedAt            DateTime?             @map("exported_at")
  publishedAt           DateTime?             @map("published_at")
  cancelledAt           DateTime?             @map("cancelled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  organisation          Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member                Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)
  birthdayPreparations  BirthdayPreparation[]
  history               DesignJobHistory[]

  @@index([organisationId, status])
  @@index([organisationId, memberId])
  @@index([organisationId, dueDate])
  @@map("design_jobs")
}

model DesignJobHistory {
  id              String           @id @default(cuid())
  organisationId  String           @map("organisation_id")
  designJobId     String           @map("design_job_id")
  previousStatus  DesignJobStatus? @map("previous_status")
  newStatus       DesignJobStatus  @map("new_status")
  note            String?
  changedByUserId String?          @map("changed_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  designJob       DesignJob        @relation(fields: [designJobId], references: [id], onDelete: Cascade)
  changedByUser   User?            @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, designJobId, createdAt])
  @@map("design_job_history")
}