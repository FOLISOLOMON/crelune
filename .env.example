# ==============================================================================
# CRELUNE — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in the values for local development.
# NEVER commit .env.local or real secrets to source control.
# ==============================================================================

# Database — Neon Lakebase Postgres
# Pooled connection string (for web applications and serverless queries)
DATABASE_URL="postgresql://username:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string (for Prisma migrations and schema changes)
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"

# Neon Branch Information
NEON_BRANCH="development"
NEON_BRANCH_ID="br-example-id"
NEON_FUNCTION_HOST_SUFFIX=".compute.region.aws.neon.tech"

# Application Security
# Generate a strong 32+ character random string for production sessions
SESSION_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
# Generate a strong 32+ character random bearer secret for POST /api/cron/birthday-reminders (never pass via URL query params)
CRON_SECRET="replace-with-a-secure-random-cron-secret-at-least-32-chars"

# Reverse Proxy & CSRF / Client IP Configuration (Optional)
# Set TRUST_PROXY="true" ONLY behind a trusted ingress reverse proxy that overwrites
# X-Forwarded-Host, X-Forwarded-Proto, and X-Real-IP (or the rightmost X-Forwarded-For hop).
# Never enable on direct untrusted connections where clients control forwarding headers.
TRUST_PROXY="false"
# Comma-separated canonical origins allowed for CSRF Origin/Referer checks in production
# ALLOWED_ORIGINS="https://crelune.example.com"

# Neon Object Storage (Private Member Photos & Future Assets — Server-Side Only)
AWS_ENDPOINT_URL_S3="https://br-example-id.storage.region.aws.neon.tech"
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID="replace-with-branch-scoped-storage-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-branch-scoped-storage-secret-key"
OBJECT_STORAGE_BUCKET="crelune-dev-member-photos"
OBJECT_STORAGE_ENV_PREFIX="development"
# Explicit deployment configuration assertion identifying which Neon branch issued the storage credential
# (Not cryptographic proof — always provision branch-scoped credentials from that exact Neon branch)
OBJECT_STORAGE_CREDENTIAL_BRANCH_ID="br-example-id"

# Windows Creative Agent
# Shared secret for local agent daemon authentication
CREATIVE_AGENT_API_KEY="replace-with-agent-api-key"
